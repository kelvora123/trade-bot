# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Trading 212 (create API keys in the T212 app: Settings -> API). Demo and live keys are separate.
T212_API_KEY=
T212_API_SECRET=

# Interactive Brokers (optional, phase 5). TWS/IB Gateway must be running locally.
IBKR_HOST=127.0.0.1
IBKR_PORT=4002
IBKR_CLIENT_ID=7

# Telegram (optional): create a bot with @BotFather, then message it once and read your chat id.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Market data (optional): Alpaca's free data API gives years of 1-minute US bars.
ALPACA_API_KEY=
ALPACA_API_SECRET=

# AI coach (optional). Claude via the official API, or a local model via Ollama.
ANTHROPIC_API_KEY=
OLLAMA_HOST=http://localhost:11434

# Live trading needs BOTH `mode: live` in config.yaml AND this exact value.
SIMPLEBOT_LIVE_CONFIRM=
