#   sudo cp deploy/simplebot-coach.* /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now simplebot-coach.timer
[Unit]
Description=Run the Simplebot coach every weekday evening (after the US close)

[Timer]
OnCalendar=Mon..Fri 22:30 Europe/London
Persistent=true

[Install]
WantedBy=timers.target
